#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
  printf 'Usage: %s [install-dir]\n' "$0" >&2
  exit 2
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
install_dir=${1:-"$HOME/.local/bin"}

mkdir -p -- "$install_dir"
install -m 755 -- "$script_dir/kindle-ja" "$install_dir/"

printf 'Installed kindle-ja to %s\n' "$install_dir"
