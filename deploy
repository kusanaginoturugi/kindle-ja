#!/bin/sh
# kindle-ja と kindle-ja-ocrd を入れ、kindle-ja-ocrd の systemd user サービスを置く。
# OCR サーバーの Python 環境は ./setup-ocrd で別に作る（なければ kindle-ja は tesseract で読む）。
set -eu

if [ "$#" -gt 1 ]; then
  printf 'Usage: %s [install-dir]\n' "$0" >&2
  exit 2
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
install_dir=${1:-"$HOME/.local/bin"}
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

mkdir -p -- "$install_dir" "$unit_dir"
install -m 755 -- "$script_dir/kindle-ja" "$script_dir/kindle-ja-ocrd" "$install_dir/"
# サービスは入れた場所の kindle-ja-ocrd を起動する
sed "s|%h/.local/bin/kindle-ja-ocrd|$install_dir/kindle-ja-ocrd|" \
  "$script_dir/systemd/kindle-ja-ocrd.service" > "$unit_dir/kindle-ja-ocrd.service"

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload
  # 動いていれば、新しい kindle-ja-ocrd で起動し直す
  systemctl --user try-restart kindle-ja-ocrd.service
fi

printf 'Installed kindle-ja, kindle-ja-ocrd to %s and kindle-ja-ocrd.service to %s\n' "$install_dir" "$unit_dir"
